{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sorbo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "sorbolabs.com", "custom_domain": true },
    { "pattern": "www.sorbolabs.com", "custom_domain": true }
  ]
}
