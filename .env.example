# Frontend (Vite)
VITE_CONVEX_URL=

# Convex backend — se setean con `bunx convex env set` (prod) o en el dashboard
MP_ACCESS_TOKEN=            # app única de Mercado Pago, directo a prod
MP_WEBHOOK_SECRET=          # firma HMAC de los webhooks (x-signature)
EVM_ADDRESS=                # wallet dedicada de la campaña (base, polygon, ethereum, optimism, bsc, celo, monad)
INDEXER_API_KEY=            # Alchemy (o equivalente) para scan + getTx
RESEND_API_KEY=             # notificaciones transaccionales
BRRR_KEY=                   # push al cel del admin (brrr.now, bearer del webhook compartido)
SITE_URL=                   # https://sorbolabs.com — URLs de retorno de MP
